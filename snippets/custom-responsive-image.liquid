{% assign image_url = image %}
{% assign alt_text = alt %}
{% assign title_text = title %}
{% assign class = class %}

{% capture srcset %}
  {{ image_url | img_url: '375x' }} 375w,
  {{ image_url | img_url: '550x' }} 550w,
  {{ image_url | img_url: '750x' }} 750w,
  {{ image_url | img_url: '1080x' }} 1080w,
  {{ image_url | img_url: '1200x' }} 1200w,
  {{ image_url | img_url: '1400x' }} 1400w,
  {{ image_url | img_url: '1600x' }} 1600w,
  {{ image_url | img_url: '1780x' }} 1780w,
  {{ image_url | img_url: '2000x' }} 2000w,
  {{ image_url | img_url: '3000x' }} 3000w,
  {{ image_url | img_url: '3840x' }} 3840w
{% endcapture %}

{% assign sizes = "(max-width: 375px) 375px, (max-width: 550px) 550px, (max-width: 750px) 750px, (max-width: 1080px) 1080px, (max-width: 1200px) 1200px, (max-width: 1400px) 1400px, (max-width: 1600px) 1600px, (max-width: 1780px) 1780px, (max-width: 2000px) 2000px, (max-width: 3000px) 3000px, 3840px" %}

<img
  class="{{ class }}"
  data-wow-delay="1.8s"
  src="{{ image_url | image_url: width: 1445 }}"
  srcset="{{ srcset }}"
  sizes="{{ sizes }}"
  alt="{{ alt_text }}"
  title="more about {{ title_text }}"
  loading="lazy"
  width="1600"
  height="{{ 1600 | divided_by: image_url.aspect_ratio | ceil }}"
>

