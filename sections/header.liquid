<div class="customHeader position-fixed top-0 left-0 w-100">
  <div class="container">
    <div class="d-flex justify-content-between py-24">
      <div class="d-flex justify-content-header align-content-header">
        {% if settings.logo != blank %}
          <a href="/" class="d-flex justify-content-header align-content-header pr-42">
            <img
              src="{{ settings.logo | img_url: 'master' }}"
              alt="{{ shop.name }}"
              class="logo-image"
              {% if settings.logo_width != blank %}
              style="width: {{ settings.logo_width }}px;"
              {% endif %}>
          </a>
        {% else %}
          <a href="/" class="logo-text">{{ shop.name }}</a>
        {% endif %}
      </div>
      <nav class="customHeader__menu align-items-center pl-40">
        <ul class="d-flex align-items-center m-0 p-0 gap-32">
          {% for link in linklists[section.settings.menu].links %}
            <li>
              <a class="p text-white fw-semibold" href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
      <div class="customHeader__btn-menu">
        <button type="button">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 40 40"><path stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 20h18m-18-6h18M11 26h18"/></svg>
        </button>
      </div>
      <div class="customHeader__btn">
        <a href="{{ section.settings.login_url }}" class="btn btn-transparent">Log in</a>
        <a href="{{ section.settings.signup_url }}" class="btn btn-primary">Sign up</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Header",
    "tag": "header",
    "settings": [
      {
        "type": "header",
        "content": "Configuración del Menú"
      },
      {
        "type": "link_list",
        "id": "menu",
        "label": "Menú"
      },
      {
        "type": "header",
        "content": "Enlaces de Botones"
      },
      {
        "type": "url",
        "id": "login_url",
        "label": "URL de inicio de sesión"
      }, {
        "type": "url",
        "id": "signup_url",
        "label": "URL de registro"
      }
    ],
    "presets": [
      {
        "name": "Cabecera Personalizada",
        "category": "Encabezado"
      }
    ]
  }
{% endschema %}